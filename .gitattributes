# Normalise all text files to LF in the index and in the working tree.
# The repo is developed on Windows with core.autocrlf=true, which would
# otherwise store CRLF and break the Python/JS golden-fixture parity tests.
* text=auto eol=lf

# Explicit text types (belt and braces for the files that matter most).
*.py     text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.txt    text eol=lf
*.ipynb  text eol=lf

# Binary: never touch these, never diff them as text.
*.onnx   binary
*.task   binary
*.npy    binary
*.npz    binary
*.parquet binary
*.pt     binary
*.pth    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webm   binary
*.mp4    binary
